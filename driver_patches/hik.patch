+# 编译头文件和运行库必须来自同一套 SDK，禁止新旧版本混用。
+set(HIK_SDK_ROOT "$ENV{HIK_SDK_ROOT}" CACHE PATH "MVS SDK root")
+if(NOT HIK_SDK_ROOT)
+  if(EXISTS "/opt/MVS/include/MvCameraControl.h")
+    set(HIK_SDK_ROOT "/opt/MVS")
+  else()
+    set(HIK_SDK_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/hikSDK")
+  endif()
+endif()
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
+  set(SDK_ARCH amd64)
+elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
+  set(SDK_ARCH arm64)
 else()
-  message(FATAL_ERROR "Unsupport host system architecture: ${CMAKE_HOST_SYSTEM_PROCESSOR}!")
+  message(FATAL_ERROR "Unsupported architecture: ${CMAKE_SYSTEM_PROCESSOR}")
 endif()
