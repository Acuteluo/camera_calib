+if(EXISTS "${HIK_SDK_ROOT}/lib/${SDK_ARCH}/libMvCameraControl.so")
+  set(SDK_LIB "${HIK_SDK_ROOT}/lib/${SDK_ARCH}")
+else()
+  set(SDK_LIB "${HIK_SDK_ROOT}/lib/64")
+endif()
+if(NOT EXISTS "${HIK_SDK_ROOT}/include/MvCameraControl.h" OR
+   NOT EXISTS "${SDK_LIB}/libMvCameraControl.so")
+  message(FATAL_ERROR "Incomplete MVS SDK: ${HIK_SDK_ROOT}")
+endif()
+message(STATUS "MVS SDK headers=${HIK_SDK_ROOT}/include libraries=${SDK_LIB}")
+target_include_directories(${PROJECT_NAME} PUBLIC "${HIK_SDK_ROOT}/include")
+target_link_libraries(${PROJECT_NAME} "${SDK_LIB}/libMvCameraControl.so")
+# 传输层与图像转换库也来自同一版本，SDK 会在运行时载入它们。
+install(DIRECTORY "${SDK_LIB}/" DESTINATION lib)
 
