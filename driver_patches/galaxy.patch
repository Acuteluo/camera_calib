+  bool selectPixelFormat()
+  {
+    uint32_t entry_count = 0;
+    GX_STATUS status = GXGetEnumEntryNums(camera_handle_, GX_ENUM_PIXEL_FORMAT, &entry_count);
+    if (!GX_SUCCESS(status) || entry_count == 0) {
+      RCLCPP_FATAL(this->get_logger(), "Cannot enumerate supported PixelFormat values (status=%d)", status);
+      return false;
+    }
+
+    std::vector<GX_ENUM_DESCRIPTION> entries(entry_count);
+    size_t buffer_size = entries.size() * sizeof(GX_ENUM_DESCRIPTION);
+    status = GXGetEnumDescription(camera_handle_, GX_ENUM_PIXEL_FORMAT, entries.data(), &buffer_size);
+    if (!GX_SUCCESS(status) || buffer_size % sizeof(GX_ENUM_DESCRIPTION) != 0 ||
+        buffer_size > entries.size() * sizeof(GX_ENUM_DESCRIPTION)) {
+      RCLCPP_FATAL(this->get_logger(), "Cannot read supported PixelFormat values (status=%d)", status);
+      return false;
+    }
+    const size_t returned_count = buffer_size / sizeof(GX_ENUM_DESCRIPTION);
+
+    // 拜耳8位优先以保留彩色信息；只支持灰度输出的型号回退到 Mono8。
+    const struct PixelFormatChoice {
+      int64_t value;
+      const char * name;
+    } choices[] = {
+      {GX_PIXEL_FORMAT_BAYER_GR8, "BayerGR8"},
+      {GX_PIXEL_FORMAT_BAYER_RG8, "BayerRG8"},
+      {GX_PIXEL_FORMAT_BAYER_GB8, "BayerGB8"},
+      {GX_PIXEL_FORMAT_BAYER_BG8, "BayerBG8"},
+      {GX_PIXEL_FORMAT_MONO8, "Mono8"},
+    };
+    int64_t requested_value = -1;
+    const char * requested_name = nullptr;
+    for (const auto & choice : choices) {
+      for (size_t i = 0; i < returned_count; ++i) {
+        if (entries[i].nValue == choice.value) {
+          requested_value = choice.value;
+          requested_name = choice.name;
+          break;
+        }
+      }
+      if (requested_name != nullptr) break;
+    }
+    if (requested_name == nullptr) {
+      std::string available;
+      for (size_t i = 0; i < returned_count; ++i) {
+        if (!available.empty()) available += ", ";
+        available += std::string(entries[i].szSymbolic,
+          strnlen(entries[i].szSymbolic, sizeof(entries[i].szSymbolic)));
+      }
+      RCLCPP_FATAL(this->get_logger(),
+        "Camera has no supported Bayer8 or Mono8 PixelFormat (available: %s)", available.c_str());
+      return false;
+    }
+
+    bool writable = false;
+    status = GXIsWritable(camera_handle_, GX_ENUM_PIXEL_FORMAT, &writable);
+    if (!GX_SUCCESS(status)) {
+      RCLCPP_FATAL(this->get_logger(), "Cannot query PixelFormat writability, status=%d", status);
+      return false;
+    }
+    int64_t actual_value = -1;
+    if (writable) {
+      status = GXSetEnum(camera_handle_, GX_ENUM_PIXEL_FORMAT, requested_value);
+      if (!GX_SUCCESS(status)) {
+        RCLCPP_FATAL(this->get_logger(), "Cannot select %s PixelFormat, status=%d", requested_name, status);
+        return false;
+      }
+    }
+    status = GXGetEnum(camera_handle_, GX_ENUM_PIXEL_FORMAT, &actual_value);
+    if (!GX_SUCCESS(status)) {
+      RCLCPP_FATAL(this->get_logger(), "Cannot verify active PixelFormat, status=%d", status);
+      return false;
+    }
+    bool actual_supported = false;
+    const char * actual_name = "unknown";
+    for (const auto & choice : choices) {
+      if (actual_value == choice.value) {
+        actual_supported = true;
+        actual_name = choice.name;
+        break;
+      }
+    }
+    if (!actual_supported || (writable && actual_value != requested_value)) {
+      RCLCPP_FATAL(this->get_logger(),
+        "PixelFormat selection did not take effect (requested=%s, actual=%ld)",
+        requested_name, static_cast<long>(actual_value));
+      return false;
+    }
+
+    selected_pixel_format_ = actual_value;
+    RCLCPP_INFO(this->get_logger(), "Selected PixelFormat=%s (%ld)", actual_name,
+      static_cast<long>(actual_value));
+    return true;
+  }
+
+  bool configureEnumFeature(GX_FEATURE_ID_CMD feature, const char * name, int64_t value)
+  {
+    bool implemented = false;
+    GX_STATUS status = GXIsImplemented(camera_handle_, feature, &implemented);
+    if (!GX_SUCCESS(status)) {
+      RCLCPP_ERROR(this->get_logger(), "Cannot query %s support, status = %d", name, status);
+      return false;
+    }
